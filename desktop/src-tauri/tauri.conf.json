{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "teul",
  "version": "../../app/package.json",
  "identifier": "com.teul.app",
  "build": {
    "frontendDist": "../../app/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Липове",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0e0f1f"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "category": "Game",
    "shortDescription": "Липове — тихе містечко за справжнім календарем",
    "longDescription": "teul: an offline pixel-art town that lives by the real calendar and clock.",
    "copyright": "teul",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": true }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["Ukrainian", "English"], "displayLanguageSelector": false }
    }
  }
}
